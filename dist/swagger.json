{
    "openapi": "3.0.0",
    "info": {
        "title": "Fullstack Node.js API",
        "version": "1.0.0",
        "description": "Zentrale Dokumentation der Express-Schnittstellen. Verknüpfung zu Python-Services vorhanden."
    },
    "components": {
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "ApiSuccess": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Operation erfolgreich"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true
                    }
                }
            },
            "ApiError": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "error"
                    },
                    "message": {
                        "type": "string",
                        "example": "Ungültige Zugangsdaten"
                    },
                    "errorDetails": {
                        "type": "string",
                        "nullable": true,
                        "example": "Error Details"
                    }
                }
            },
            "IntegrationSetup": {
                "type": "object",
                "properties": {
                    "services": {
                        "type": "object",
                        "properties": {
                            "flask": {
                                "type": "string",
                                "example": "http://localhost:5000"
                            },
                            "fastAPI": {
                                "type": "string",
                                "example": "http://localhost:8000"
                            }
                        }
                    },
                    "apiVersion": {
                        "type": "string",
                        "example": "1.0.0"
                    }
                }
            },
            "LoginCredentials": {
                "type": "object",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "geheim123"
                    }
                }
            }
        }
    },
    "paths": {
        "/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Benutzer-Anmeldung",
                "description": "Prüft E-Mail und Passwort und gibt ein JWT zurück.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginCredentials"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login erfolgreich",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiSuccess"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Ungültige Zugangsdaten",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/integration/setup": {
            "get": {
                "tags": [
                    "System & Integration"
                ],
                "summary": "Holt das Integrations-Setup",
                "description": "Liefert die URLs für Python-Flask (Charts) und FastAPI (Analytics) sowie die API-Version.",
                "responses": {
                    "200": {
                        "description": "Setup erfolgreich geladen",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ApiSuccess"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/IntegrationSetup"
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Benutzer-Abmeldung (Logout)",
                "description": "Löscht den Session-Hash aus der Datenbank und beendet die Gültigkeit des Tokens.",
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Erfolgreich abgemeldet",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiSuccess"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users": {
            "get": {
                "tags": ["Administration"],
                "summary": "Benutzerliste abrufen",
                "description": "Erfordert mindestens Moderator-Level.",
                "security": [{ "BearerAuth": [] }],
                "responses": {
                    "200": { "description": "Unterschiedliche Liste der Benutzer für Admin/Moderator" },
                    "403": { "description": "Unzureichende Berechtigungen" }
                }
            }
        },
        "/user-stats": {
            "get": {
                "tags": ["Monitoring"],
                "summary": "Benutzerstatistiken",
                "security": [{ "BearerAuth": [] }],
                "responses": { "200": { "description": "Statistik-Daten" } }
            }
        },
        "/server-time": {
            "get": {
                "tags": [
                    "System & Integration"
                ],
                "summary": "Serverzeit abfragen",
                "responses": {
                    "200": {
                        "description": "Aktuelle Serverzeit",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApiSuccess"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
